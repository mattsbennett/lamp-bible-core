    "Sources/LampModuleKit/LampSync*.swift",
    "Sources/LampModuleKit/LampShared*.swift",
    "Sources/LampModuleKit/LampWebDAV*.swift",
    "Sources/LampCore/LampSync*.swift",
    "Sources/LampCore/LampPersonalDeletionLedger.swift",
    "Sources/LampCore/LampPresentationDeckPortable.swift"
  ],
