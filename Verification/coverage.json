    "Sources/LampCore/LampLibrary.swift": {
      "rules": [
        "portableImportOutcome",
        "stagedBackupImport",
        "guardedStagedBackupCommit",
        "editableCommit",
        "tombstoneDeletes",
        "ownedSQLiteReplacement"
      ],
      "boundary": "Only the library's sync paths are modelled: personal import, staged backup import and the deletion ledger. SQLite and filesystem behaviour are assumed."
    },
    "Sources/LampCore/LampPersonalDeletionLedger.swift": {
