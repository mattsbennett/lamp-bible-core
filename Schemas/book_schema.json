{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "book-schema-v1",
  "title": "Book Module Schema",
  "description": "Schema for long-form books and other chapter-based publications. Content is organized as hierarchical sections and supports annotations, scripture references, footnotes, images, and audio.",

  "definitions": {
    "verseRef": {
      "type": "integer",
      "minimum": 1001001,
      "description": "Numeric verse reference in BBCCCVVV format (for example, 40001001 for Matthew 1:1)."
    },

    "linkVerse": {
      "type": "integer",
      "description": "A verse a link names, as BBCCCVVV: in a Bible book (1 to 66) and a chapter of it, never chapter 0; verse 0 is a psalm's title. The same bounds LampLinkTarget.destination(in:) holds a target to.",
      "anyOf": [
          { "minimum": 1001000, "maximum": 1999999 },
          { "minimum": 2001000, "maximum": 2999999 },
          { "minimum": 3001000, "maximum": 3999999 },
          { "minimum": 4001000, "maximum": 4999999 },
          { "minimum": 5001000, "maximum": 5999999 },
          { "minimum": 6001000, "maximum": 6999999 },
          { "minimum": 7001000, "maximum": 7999999 },
          { "minimum": 8001000, "maximum": 8999999 },
          { "minimum": 9001000, "maximum": 9999999 },
          { "minimum": 10001000, "maximum": 10999999 },
          { "minimum": 11001000, "maximum": 11999999 },
          { "minimum": 12001000, "maximum": 12999999 },
          { "minimum": 13001000, "maximum": 13999999 },
          { "minimum": 14001000, "maximum": 14999999 },
          { "minimum": 15001000, "maximum": 15999999 },
          { "minimum": 16001000, "maximum": 16999999 },
          { "minimum": 17001000, "maximum": 17999999 },
          { "minimum": 18001000, "maximum": 18999999 },
          { "minimum": 19001000, "maximum": 19999999 },
          { "minimum": 20001000, "maximum": 20999999 },
          { "minimum": 21001000, "maximum": 21999999 },
          { "minimum": 22001000, "maximum": 22999999 },
          { "minimum": 23001000, "maximum": 23999999 },
          { "minimum": 24001000, "maximum": 24999999 },
          { "minimum": 25001000, "maximum": 25999999 },
          { "minimum": 26001000, "maximum": 26999999 },
          { "minimum": 27001000, "maximum": 27999999 },
          { "minimum": 28001000, "maximum": 28999999 },
          { "minimum": 29001000, "maximum": 29999999 },
          { "minimum": 30001000, "maximum": 30999999 },
          { "minimum": 31001000, "maximum": 31999999 },
          { "minimum": 32001000, "maximum": 32999999 },
          { "minimum": 33001000, "maximum": 33999999 },
          { "minimum": 34001000, "maximum": 34999999 },
          { "minimum": 35001000, "maximum": 35999999 },
          { "minimum": 36001000, "maximum": 36999999 },
          { "minimum": 37001000, "maximum": 37999999 },
          { "minimum": 38001000, "maximum": 38999999 },
          { "minimum": 39001000, "maximum": 39999999 },
          { "minimum": 40001000, "maximum": 40999999 },
          { "minimum": 41001000, "maximum": 41999999 },
          { "minimum": 42001000, "maximum": 42999999 },
          { "minimum": 43001000, "maximum": 43999999 },
          { "minimum": 44001000, "maximum": 44999999 },
          { "minimum": 45001000, "maximum": 45999999 },
          { "minimum": 46001000, "maximum": 46999999 },
          { "minimum": 47001000, "maximum": 47999999 },
          { "minimum": 48001000, "maximum": 48999999 },
          { "minimum": 49001000, "maximum": 49999999 },
          { "minimum": 50001000, "maximum": 50999999 },
          { "minimum": 51001000, "maximum": 51999999 },
          { "minimum": 52001000, "maximum": 52999999 },
          { "minimum": 53001000, "maximum": 53999999 },
          { "minimum": 54001000, "maximum": 54999999 },
          { "minimum": 55001000, "maximum": 55999999 },
          { "minimum": 56001000, "maximum": 56999999 },
          { "minimum": 57001000, "maximum": 57999999 },
          { "minimum": 58001000, "maximum": 58999999 },
          { "minimum": 59001000, "maximum": 59999999 },
          { "minimum": 60001000, "maximum": 60999999 },
          { "minimum": 61001000, "maximum": 61999999 },
          { "minimum": 62001000, "maximum": 62999999 },
          { "minimum": 63001000, "maximum": 63999999 },
          { "minimum": 64001000, "maximum": 64999999 },
          { "minimum": 65001000, "maximum": 65999999 },
          { "minimum": 66001000, "maximum": 66999999 }
      ]
    },

    "verseRange": {
      "type": "object",
      "properties": {
        "sv": { "$ref": "#/definitions/verseRef", "description": "Start verse reference" },
        "ev": { "$ref": "#/definitions/verseRef", "description": "Optional end verse reference" },
        "label": { "type": "string", "description": "Optional human-readable reference" }
      },
      "required": ["sv"]
    },

    "mediaReference": {
      "type": "object",
      "description": "Reference to an image or audio file packaged with the module.",
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Unique media identifier" },
        "type": { "type": "string", "enum": ["image", "audio"] },
        "filename": { "type": "string", "minLength": 1 },
        "mimeType": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0, "description": "File size in bytes" },
        "width": { "type": "integer", "minimum": 1, "description": "Image width in pixels" },
        "height": { "type": "integer", "minimum": 1, "description": "Image height in pixels" },
        "duration": { "type": "number", "minimum": 0, "description": "Audio duration in seconds" },
        "waveform": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "description": "Normalized audio waveform samples"
        },
        "transcription": { "type": "string" },
        "alt": { "type": "string", "description": "Accessible alternative text for an image" },
        "created": { "type": "integer", "description": "Unix timestamp when the media was added" }
      },
      "required": ["id", "type", "filename", "mimeType"]
    },

    "annotation": {
      "type": "object",
      "description": "An inline annotation. start and end are Unicode scalar (code point) offsets into the annotated text, not UTF-16 units or grapheme clusters.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["scripture", "strongs", "greek", "hebrew", "link", "emphasis", "quote", "footnote", "page", "media", "smallcaps"],
          "description": "smallcaps covers the capitals as written, \"ORD\" in \"LORD\"; a reader that does not know it draws the words plainly."
        },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "data": {
          "type": "object",
          "properties": {
            "sv": { "$ref": "#/definitions/verseRef" },
            "ev": { "$ref": "#/definitions/verseRef" },
            "refs": {
              "type": "array",
              "items": { "$ref": "#/definitions/verseRange" }
            },
            "strongs": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "style": { "type": "string", "enum": ["bold", "italic", "underline"] },
            "source": { "type": "string" },
            "footnoteId": { "type": "string" },
            "pageNum": {
              "type": ["string", "integer"],
              "description": "The page number printed in the source (a roman numeral string for front matter). A page outside any printed sequence has no page annotation."
            },
            "mediaId": { "type": "string" },
            "mediaType": { "type": "string", "enum": ["image", "audio"] },
            "target": {
              "$ref": "#/definitions/linkTarget",
              "description": "On link: where it goes. On scripture: the note on that passage, which a reader that knows no targets opens as the passage."
            }
          }
        }
      },
      "required": ["type", "start", "end"],
      "allOf": [
        {
          "description": "Only a link or a scripture annotation is followed to a target.",
          "if": { "not": { "properties": { "type": { "enum": ["link", "scripture"] } } } },
          "then": { "properties": { "data": { "not": { "required": ["target"] } } } }
        },
        {
          "description": "A scripture annotation carrying a target keeps its own passage, which a reader that knows no targets opens.",
          "if": { "properties": { "type": { "const": "scripture" }, "data": { "required": ["target"] } }, "required": ["data"] },
          "then": { "properties": { "data": {
            "anyOf": [ { "required": ["sv"] }, { "required": ["refs"], "properties": { "refs": { "minItems": 1 } } } ],
            "properties": { "target": { "required": ["sv"], "description": "A scripture annotation's note is a commentary's, on a passage." } }
          } } }
        }
      ]
    },

    "linkTarget": {
      "type": "object",
      "description": "A place in an installed module, by kind and declared ID: never a stored row ID. Exactly one route: a commentary passage (sv), a commentary volume's front matter (book and section), or a book section (section).",
      "properties": {
        "kind": { "type": "string", "enum": ["commentary", "book"], "description": "Omitted: the kind of the module the link is in." },
        "module": { "type": "string", "minLength": 1, "description": "The target module's declared ID; a commentary's series ID. Omitted: this module." },
        "sv": { "$ref": "#/definitions/linkVerse" },
        "ev": { "$ref": "#/definitions/linkVerse" },
        "suffix": { "type": "string" },
        "unit": { "type": "string", "minLength": 1, "description": "Commentary, with sv: the declared ID of a section or pericope starting at sv. Omitted: the note on the passage." },
        "book": { "type": "integer", "minimum": 1, "maximum": 66, "description": "Commentary front matter: the volume's Bible book." },
        "section": { "type": "string", "minLength": 1, "description": "A book's section ID, or with book a commentary volume's front-matter section." },
        "anchor": { "type": "string", "minLength": 1, "description": "A block id inside the unit or section the rest of the target finds." }
      },
      "dependencies": { "module": ["kind"] },
      "oneOf": [
        { "required": ["sv", "kind", "module"], "properties": { "kind": { "const": "commentary" } },
          "not": { "anyOf": [ { "required": ["section"] }, { "required": ["book"] } ] },
          "description": "A commentary passage: in a book, always another module's, so named with its kind." },
        { "required": ["book", "section", "kind", "module"], "properties": { "kind": { "const": "commentary" } },
          "not": { "anyOf": [ { "required": ["sv"] }, { "required": ["ev"] }, { "required": ["suffix"], "properties": { "suffix": { "minLength": 1 } } }, { "required": ["unit"] } ] },
          "description": "A commentary volume's front matter: in a book, always another module's." },
        { "required": ["section"], "properties": { "kind": { "const": "book" } },
          "not": { "anyOf": [ { "required": ["sv"] }, { "required": ["ev"] }, { "required": ["suffix"], "properties": { "suffix": { "minLength": 1 } } }, { "required": ["unit"] }, { "required": ["book"] } ] } }
      ]
    },

    "footnoteReference": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Unicode scalar (code point) offset into the annotated text."
        }
      },
      "required": ["id", "offset"]
    },

    "annotatedText": {
      "type": "object",
      "description": "Plain text plus offset-based annotations and footnote markers.",
      "properties": {
        "text": { "type": "string" },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/definitions/annotation" }
        },
        "footnote_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/footnoteReference" }
        }
      },
      "required": ["text"]
    },

    "textValue": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/definitions/annotatedText" }
      ]
    },

    "footnote": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "content": { "$ref": "#/definitions/textValue" }
      },
      "required": ["id", "content"]
    },

    "listItem": {
      "type": "object",
      "properties": {
        "content": { "$ref": "#/definitions/annotatedText" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/listItem" }
        }
      },
      "required": ["content"]
    },

    "tableCell": {
      "type": "object",
      "description": "One cell in a table, positioned by its zero-based column index.",
      "properties": {
        "content": { "$ref": "#/definitions/annotatedText" },
        "column": { "type": "integer", "minimum": 0 },
        "header": { "type": "boolean", "default": false },
        "colSpan": { "type": "integer", "minimum": 1, "default": 1 },
        "rowSpan": { "type": "integer", "minimum": 1, "default": 1 },
        "align": { "type": "string", "enum": ["left", "center", "right"] },
        "label": { "type": "string", "description": "Opaque: cells sharing a label may be drawn alike, and a legend names them." }
      },
      "required": ["content", "column"]
    },

    "tableRow": {
      "type": "object",
      "properties": {
        "cells": {
          "type": "array",
          "items": { "$ref": "#/definitions/tableCell" }
        },
        "label": { "type": "string", "description": "Opaque: rows sharing a label may be drawn alike, and a legend names them." }
      },
      "required": ["cells"]
    },

    "legendEntry": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      },
      "required": ["label", "title"]
    },

    "figureChild": {
      "description": "A block inside a figure: a picture, paragraph, list, table or heading. Never another figure.",
      "allOf": [
        { "$ref": "#/definitions/contentBlock" },
        { "properties": { "type": { "enum": ["image", "paragraph", "list", "table", "heading"] }, "children": { "maxItems": 0 } } }
      ]
    },

    "contentBlock": {
      "type": "object",
      "description": "A display block within a section.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["paragraph", "list", "blockquote", "heading", "table", "image", "audio", "thematic-break", "figure"]
        },
        "content": { "$ref": "#/definitions/annotatedText" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "listType": { "type": "string", "enum": ["bullet", "numbered"] },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/listItem" }
        },
        "columnCount": { "type": "integer", "minimum": 1 },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/definitions/tableRow" }
        },
        "mediaId": { "type": "string", "description": "ID of an item in the top-level media array" },
        "caption": { "$ref": "#/definitions/textValue" },
        "alignment": { "type": "string", "enum": ["left", "center", "right", "full"] },
        "showWaveform": { "type": "boolean" },
        "autoplay": { "type": "boolean" },
        "id": { "type": "string", "minLength": 1, "description": "The block's anchor, unique within the module; in a commentary, within the volume." },
        "role": { "type": "string", "description": "What the author calls the block, such as map or chart. Not interpreted." },
        "title": { "$ref": "#/definitions/textValue", "description": "A figure's title." },
        "subtitle": { "$ref": "#/definitions/textValue", "description": "A figure's second line, such as an era or date." },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/figureChild" },
          "description": "A figure's contents, in printed order. A later titled part opens with a heading child."
        },
        "notes": {
          "type": "array",
          "items": { "$ref": "#/definitions/annotatedText" },
          "description": "Notes printed under a figure."
        },
        "legend": {
          "type": "array",
          "items": { "$ref": "#/definitions/legendEntry" },
          "description": "What the labels on a table's rows and cells stand for."
        }
      },
      "required": ["type"],
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["paragraph", "blockquote", "heading"] } } },
          "then": { "required": ["content"] }
        },
        {
          "if": { "properties": { "type": { "const": "list" } } },
          "then": { "required": ["listType", "items"] }
        },
        {
          "if": { "properties": { "type": { "const": "table" } } },
          "then": { "required": ["columnCount", "rows"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["image", "audio"] } } },
          "then": { "required": ["mediaId"] }
        },
        {
          "if": { "properties": { "type": { "const": "heading" } } },
          "then": { "required": ["level"] }
        },
        {
          "if": { "properties": { "type": { "const": "figure" } } },
          "then": { "required": ["children"] },
          "else": { "properties": { "children": { "maxItems": 0 } } }
        }
      ]
    },

    "section": {
      "type": "object",
      "description": "A hierarchical book unit such as a preface, part, chapter, or appendix.",
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Identifier unique within this book" },
        "type": {
          "type": "string",
          "enum": ["front-matter", "part", "chapter", "section", "appendix", "back-matter", "other"]
        },
        "number": {
          "type": ["string", "integer"],
          "description": "Optional displayed number or label, such as 3, IV, or Appendix A"
        },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "order": { "type": "integer", "minimum": 0, "description": "Optional explicit sibling sort order; array order is used when omitted" },
        "keyScriptures": {
          "type": "array",
          "items": { "$ref": "#/definitions/verseRange" }
        },
        "content": {
          "type": "array",
          "items": { "$ref": "#/definitions/contentBlock" }
        },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/definitions/section" }
        }
      },
      "required": ["id", "type", "title"],
      "anyOf": [
        { "required": ["content"] },
        { "required": ["sections"] }
      ]
    }
  },

  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "description": "Book and publication metadata.",
      "properties": {
        "schemaVersion": { "type": "string", "const": "1.0" },
        "id": { "type": "string", "minLength": 1, "description": "Unique module identifier" },
        "type": { "type": "string", "const": "book" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "editor": { "type": "string" },
        "publisher": { "type": "string" },
        "year": { "type": "integer", "minimum": 0 },
        "edition": { "type": "string" },
        "isbn": { "type": "string" },
        "language": { "type": "string", "minLength": 2, "description": "BCP 47 language tag, such as en" },
        "textDirection": { "type": "string", "enum": ["ltr", "rtl"] },
        "copyright": { "type": "string" },
        "license": { "type": "string" },
        "version": { "type": "string", "description": "Version of this module's content" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "genre": { "type": "string", "description": "ID of the book's genre, one of the bundle's book_genres, such as first-principles" },
        "coverMediaId": { "type": "string", "description": "ID of the cover image in the top-level media array" },
        "isEditable": { "type": "boolean", "default": false },
        "created": { "type": "integer", "description": "Unix timestamp when the module was created" },
        "lastModified": { "type": "integer", "description": "Unix timestamp of the last modification" }
      },
      "required": ["schemaVersion", "id", "type", "title", "language"]
    },

    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/section" },
      "description": "The book's ordered, hierarchical contents."
    },

    "footnotes": {
      "type": "array",
      "items": { "$ref": "#/definitions/footnote" },
      "description": "Footnotes shared by all sections in the book."
    },

    "media": {
      "type": "array",
      "items": { "$ref": "#/definitions/mediaReference" },
      "description": "Media referenced by the cover or content blocks."
    }
  },
  "required": ["meta", "sections"]
}
